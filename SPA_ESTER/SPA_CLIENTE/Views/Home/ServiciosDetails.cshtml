@model ClassLibrary1.Servicios

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div> 
     

    <!-- Product section-->
    <section class="py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="row gx-4 gx-lg-5 align-items-center">
                <div class="col-md-6"><img class="card-img-top mb-5 mb-md-0" src="@Url.Action("GetImage", "Servicios", new { id = Model.id_servicios })" alt="..." /></div>
                <div class="col-md-6">
                    <div class="small mb-1">SKU: BST-498</div>
                    <h1 class="display-5 fw-bolder">@Html.DisplayFor(model => model.nombre_ser)</h1>
                    <div class="fs-5 mb-5">
                        <span class="text-decoration-line-through">$@Html.DisplayFor(model => model.precio_ser)</span>
                        <span>$@Html.DisplayFor(model => model.precio_ser)</span>
                    </div>
                    <p class="lead">@Html.DisplayFor(model => model.descripción_ser)</p>
                    <div class="d-flex">
                        
                        <button class="btn btn-outline-dark flex-shrink-0" type="button">
                            <i class="bi-cart-fill me-1"></i>
                             
                            @Html.ActionLink("RESERVAR", "CreateReserva", "Reservas", new { id_servicios = Model.id_servicios }, new { @class = "navbar-brand mt-auto" })
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>
     
</div> 
