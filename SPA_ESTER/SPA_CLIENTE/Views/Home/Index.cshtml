<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Bootstrap CSS -->
     
    <link href="~/Content/Home.css" rel="stylesheet" />
</head>
<body>



    <!-- Header-->
    <header class="bg-dark py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="text-center text-white">
                <h1 class="display-4 fw-bolder">Amarse es un ritual</h1>
                <p class="lead fw-normal text-white-50 mb-0">Spa Ester el ritual que tu cuerpo necesita</p>
            </div>
        </div>
    </header>

    <!-- Services Section -->
    <div class="container my-5">
        <div class="row">
            <!-- Service 1 -->


            @foreach (var item in Model)
            {

                <div class="col-md-4">
                    <div class="card service-card">
                        <div class="badge bg-dark text-white position-absolute" style="top: 0.5rem; right: 0.5rem">Sale</div>
                        @*<img class="card-img-top" src="https://us.123rf.com/450wm/serezniy/serezniy1806/serezniy180615383/102759033-rel%C3%A1jese-en-la-mesa-con-fondo-de-madera.jpg?ver=6" alt="..." />*@

                        <img class="card-img-top" src="@Url.Action("GetImage", "Servicios", new { id = item.id_servicios })" alt="..." />

                        <div class="card-body p-4">
                            <div class="text-center">
                                <h5 class="card-title">@Html.DisplayFor(modelItem => item.nombre_ser)</h5>
                                <p class="card-text">@Html.DisplayFor(modelItem => item.descripción_ser)</p>
                                <span class="text-muted text-decoration-line-through">@Html.DisplayFor(modelItem => item.precio_ser)</span>
                            </div>
                        </div>

                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <div class="text-center">@Html.ActionLink("Add to cart", "Reserva", new { id_servicios = item.id_servicios }, new { @class = "btn btn-outline-dark mt-auto"})</div>
                        </div>

                    </div>
                </div>
            }

             
        </div>
    </div>
 



    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="#"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
