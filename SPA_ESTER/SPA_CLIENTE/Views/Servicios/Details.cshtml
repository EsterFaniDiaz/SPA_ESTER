@model ClassLibrary1.Servicios

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Details</h2>

<div>
    <h4>Servicios</h4>
    <hr />

    <!-- Product section-->
    <section class="py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="row gx-4 gx-lg-5 align-items-center">
                <div class="col-md-6"><img class="card-img-top mb-5 mb-md-0" src="@Url.Action("GetImage", "Servicios", new { id = Model.id_servicios })" alt="..." /></div>
                <div class="col-md-6">
                    <div class="small mb-1">SKU: BST-498</div>
                    <h1 class="display-5 fw-bolder">@Html.DisplayNameFor(model => model.nombre_ser)</h1>
                    <div class="fs-5 mb-5">
                        <span class="text-decoration-line-through">$@Html.DisplayNameFor(model => model.precio_ser -10)</span>
                        <span>$@Html.DisplayNameFor(model => model.precio_ser)</span>
                    </div>
                    <p class="lead">@Html.DisplayNameFor(model => model.descripción_ser)</p>
                    <div class="d-flex">
                        <input class="form-control text-center me-3" id="inputQuantity" type="num" value="1" style="max-width: 3rem" />
                        <button class="btn btn-outline-dark flex-shrink-0" type="button">
                            <i class="bi-cart-fill me-1"></i>
                            Add to cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <dl class="dl-horizontal">
        <dt>
            
        </dt>

        <dd>
            @Html.DisplayFor(model => model.precio_ser)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.descripción_ser)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.descripción_ser)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.nombre_ser)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.nombre_ser)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.id_servicios }) |
    @Html.ActionLink("Back to List", "Index")
</p>
