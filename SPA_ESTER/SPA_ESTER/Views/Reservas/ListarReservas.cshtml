@model IEnumerable<ClassLibrary1.Models.ListarReservasModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Reservas</h2>


<style>
    .navbar {
        margin-bottom: 0px !important;
    }

    .filterable {
        margin-top: 15px;
    }

        .filterable .panel-heading .pull-right {
            margin-top: -20px;
        }

        .filterable .filters input[disabled] {
            background-color: transparent;
            border: none;
            cursor: auto;
            box-shadow: none;
            padding: 0;
            height: auto;
        }

            .filterable .filters input[disabled]::-webkit-input-placeholder {
                color: #333;
            }

            .filterable .filters input[disabled]::-moz-placeholder {
                color: #333;
            }

            .filterable .filters input[disabled]:-ms-input-placeholder {
                color: #333;
            }
</style>

<link href="//netdna.bootstrapcdn.com/bootstrap/3.1.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//netdna.bootstrapcdn.com/bootstrap/3.1.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<div class="col-12">
    <div class="row">
        <div class="panel panel-primary filterable">
            <div class="panel-heading">
                <h2 class="panel-title">Reservas</h2>
                <div class="pull-right">
                    <button class="btn btn-default btn-xs btn-filter"><span class="glyphicon glyphicon-filter"></span> Filter</button>
                </div>
            </div>
            <table class="table">
                <thead>

                    <tr class="filters">
                        <th><input type="text" class="form-control" placeholder="Estado" disabled></th>
                        <th><input type="text" class="form-control" placeholder="Nombre del cliente" disabled></th>
                        <th><input type="text" class="form-control" placeholder="Fecha y Hora" disabled></th>
                        <th><input type="text" class="form-control" placeholder="Servicio" disabled></th>
                        <th><input type="text" class="form-control" placeholder="Precio" disabled></th>
                        <th><input type="text" class="form-control" placeholder="Metodo de pago" disabled></th>
                        <th><input type="text" class="form-control" placeholder="Empleado" disabled></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {

                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.estado_reserva)</td>
                            <td>@Html.DisplayFor(modelItem => item.Clientes.nombre_cl)</td>
                            <td>@Html.DisplayFor(modelItem => item.fecha_reserva)</td>
                            <td>@Html.DisplayFor(modelItem => item.Servicio.nombre_ser)</td>
                            <td>@Html.DisplayFor(modelItem => item.Servicio.precio_ser)</td>
                            <td>@Html.DisplayFor(modelItem => item.Metodos_Pago.nombre_metodo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Empleados.nombre_emp)</td>

                            <td>
                                @if (item.estado_reserva == "DESASIGNADA")
                                {
                                    @Html.ActionLink("Asignar Empleado", "Edit", new { id = item.id_reservas }, new { @class = "btn btn-secondary btn-sm" })

                                }
                                @if (item.estado_reserva == "FACTURADA")
                                {
                                    <!-- Enlace "Consultar" estilizado como un botón -->
                                    @Html.ActionLink("Ver Factura", "Factura", "Facturas", new { id_factura = item.id_factura }, new { @class = "btn btn-primary btn-sm" })
                                }
                                @if (item.estado_reserva == "ASIGNADA")
                                {
                                    <!-- Enlace "Consultar" estilizado como un botón -->
                                    @Html.ActionLink("Facturar", "PreFactura", "Facturas", new { idReserva = item.id_reservas }, new { @class = "btn btn-success btn-sm" })
                                }
                                @if (item.estado_reserva != "FACTURADA")
                                {
                                    <!-- Enlace "Eliminar" estilizado como un botón -->
                                    @Html.ActionLink("Cancelar", "Delete", new { id = item.id_reservas }, new { @class = "btn btn-danger btn-sm" })
                                }
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        $('.filterable .btn-filter').click(function () {
            var $panel = $(this).parents('.filterable'),
                $filters = $panel.find('.filters input'),
                $tbody = $panel.find('.table tbody');
            if ($filters.prop('disabled') == true) {
                $filters.prop('disabled', false);
                $filters.first().focus();
            } else {
                $filters.val('').prop('disabled', true);
                $tbody.find('.no-result').remove();
                $tbody.find('tr').show();
            }
        });

        $('.filterable .filters input').keyup(function (e) {
            /* Ignore tab key */
            var code = e.keyCode || e.which;
            if (code == '9') return;
            /* Useful DOM data and selectors */
            var $input = $(this),
                inputContent = $input.val().toLowerCase(),
                $panel = $input.parents('.filterable'),
                column = $panel.find('.filters th').index($input.parents('th')),
                $table = $panel.find('.table'),
                $rows = $table.find('tbody tr');
            /* Dirtiest filter function ever ;) */
            var $filteredRows = $rows.filter(function () {
                var value = $(this).find('td').eq(column).text().toLowerCase();
                return value.indexOf(inputContent) === -1;
            });
            /* Clean previous no-result if exist */
            $table.find('tbody .no-result').remove();
            /* Show all rows, hide filtered ones (never do that outside of a demo ! xD) */
            $rows.show();
            $filteredRows.hide();
            /* Prepend no-result row if all rows are filtered */
            if ($filteredRows.length === $rows.length) {
                $table.find('tbody').prepend($('<tr class="no-result text-center"><td colspan="' + $table.find('.filters th').length + '">No result found</td></tr>'));
            }
        });
    });
</script>