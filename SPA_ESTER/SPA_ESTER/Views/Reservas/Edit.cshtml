@model ClassLibrary1.Reservas

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal pt-3">
        <h4>Asignar Empleado</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.id_reservas)
        @Html.HiddenFor(model => model.fecha_reserva)
        @Html.HiddenFor(model => model.estado_reserva)
        @Html.HiddenFor(model => model.id_clientes)
        @Html.HiddenFor(model => model.id_metodos_pg)

        <div class="row pt-3">
            <div class="col-md-6 form-group">
                @Html.LabelFor(model => model.id_empleados, "Empleado", htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.DropDownList("id_empleados", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.id_empleados, "", new { @class = "text-danger" })
            </div> 
        </div> 

        <div class="row pt-3">
            <div class="col-md-6 form-group">
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <!-- Botón de Crear con estilo de Bootstrap -->
                        <input type="submit" value="Guardar" class="btn btn-primary" /> |
                        <a href="/" class="btn btn-primary">Regresar</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
